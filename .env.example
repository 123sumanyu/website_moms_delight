# Store Configuration Template - Mom's Food Delight
# Copy this file to .env and customize with your own settings

# Paytm / UPI Payment Routing
PAYTM_UPI_ID=your_upi_address@paytm
PAYTM_PAYEE_NAME=Your Full Name

# WhatsApp Business Number (Receives Order Summaries)
WHATSAPP_NUMBER=10_digit_mobile_number

# Merchant Admin Dashboard Authentication
ADMIN_PASSCODE=your_secret_passcode

# Local Server Configurations
PORT=3000
